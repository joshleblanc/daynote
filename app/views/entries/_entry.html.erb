<div id="<%= dom_id entry %>">
  <% parts = entry.content.body&.deconstruct %>
  <% find_insights(entry, parts) %>
  <% parts&.each do |part| %>
    <%= part.to_s.html_safe %>
  <% end %>
  <% if entry.replies.any? %>
    <% entry.replies.each do |reply| %>
      <div class="whitespace-pre-line rounded mb-2 text-sm border-2 p-4 <%= class_names("bg-red-500/50 border-red-500" => reply.red?, "bg-yellow-500/50 border-yellow-500" => reply.yellow?, "bg-green-500/50 border-green-500" => reply.green?) %>">🤖 <span class="opacity-50">AI response</span>
        &nbsp;
        <%= reply.reply %>
      </div>
    <% end %>
  <% end %>
</div>
